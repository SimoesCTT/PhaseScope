<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHASESCOPE"
            android:textSize="22sp"
            android:textColor="@color/accent"
            android:letterSpacing="0.2"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phase coherence analyzer for EEG"
            android:textSize="12sp"
            android:textColor="@color/text_dim"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnLoad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load CSV"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnLoadEdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Load EDF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No file loaded"
            android:textSize="12sp"
            android:textColor="@color/text_dim"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/spinnerBand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnAnalyze"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analyze"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export CSV"
            android:enabled="false"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KURAMOTO ORDER PARAMETER"
            android:textSize="11sp"
            android:textColor="@color/text_dim"
            android:letterSpacing="0.15"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtOrder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="32sp"
            android:textColor="@color/accent"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtOrderLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_dim"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COHERENCE MATRIX"
            android:textSize="11sp"
            android:textColor="@color/text_dim"
            android:letterSpacing="0.15"
            android:layout_marginBottom="4dp" />

        <com.simoesctt.phasescope.PlotView
            android:id="@+id/plotView"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHANNELS"
            android:textSize="11sp"
            android:textColor="@color/text_dim"
            android:letterSpacing="0.15"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtChannels"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="12sp"
            android:textColor="@color/text"
            android:fontFamily="monospace"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
